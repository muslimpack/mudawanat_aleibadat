{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mudawana (debug, flavor)",
      "request": "launch",
      "type": "dart",
      // "args": ["--flavor", "${input:flavor}"]
    },
    {
      "name": "mudawana (profile, flavor)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--flavor",
        "${input:flavor}"
      ]
    },
    {
      "name": "mudawana (release, flavor)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--flavor",
        "${input:flavor}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "flavor",
      "type": "pickString",
      "description": "Select a build flavor",
      "options": [
        "dev",
        "prod"
      ],
      "default": "dev"
    }
  ]
}